{
  "name": "eden-agent-dev-tools",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:test": "node --test --test-concurrency=2 tests/development-hooks.test.mjs tests/development-hooks-push.test.mjs tests/development-hooks-web.test.mjs",
    "markdown:check": "node scripts/checks.mjs markdown",
    "markdown:fix": "node scripts/checks.mjs markdown-fix",
    "rust:check": "node scripts/checks.mjs fmt",
    "rust:fmt": "node scripts/checks.mjs format",
    "rust:test:authors": "node scripts/checks.mjs test",
    "clippy:check": "node scripts/checks.mjs clippy",
    "clippy:fix": "node scripts/checks.mjs clippy-fix",
    "doc:check": "node scripts/checks.mjs doc",
    "python:format": "node scripts/checks.mjs python-format",
    "python:format:check": "node scripts/checks.mjs python-format-check",
    "python:lint": "node scripts/checks.mjs python-lint",
    "python:types": "node scripts/checks.mjs python-types",
    "python:check": "node scripts/checks.mjs python",
    "js:check": "pnpm biome:check && pnpm web:check",
    "js:fix": "pnpm biome:fix",
    "biome:check": "node scripts/checks.mjs javascript",
    "biome:fix": "node scripts/checks.mjs javascript-fix",
    "web:types": "node scripts/checks.mjs web-types",
    "web:build": "pnpm --filter eden-live-presentation build",
    "web:check": "pnpm web:types && pnpm web:build"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "@biomejs/biome": "2.5.3"
  }
}
